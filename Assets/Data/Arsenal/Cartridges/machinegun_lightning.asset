    durationSeconds: 3
    radiusMetres: 3
    amount: 0.2
    barrierHealth: 0
    barrierWidth: 0
    barrierHeight: 0
    rules: "Aumenta dispersão em 20% enquanto dentro, sem mexer na sensibilidade ou direção da câmera."
  - kind: 0

    target: 2
    anchor: 1
    durationSeconds: 1.5
    radiusMetres: 5
    amount: 0
    barrierHealth: 0
    barrierWidth: 0
    barrierHeight: 0
    rules: "Ping inicial, limitado por linha de visão do impacto."
  - kind: 4
    target: 1
    anchor: 0
    durationSeconds: 2
    radiusMetres: 3
    amount: 0.1
    barrierHealth: 0
    barrierWidth: 0
    barrierHeight: 0
    rules: "Aliados vivos próximos do atirador no disparo recebem 10% de velocidade; exige visão livre."

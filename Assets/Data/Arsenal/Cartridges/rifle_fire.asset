  cartridgeId: "rifle_fire"
  cartridgeName: "Cortina de Cinzas"
  category: 5
  element: 0
  primaryRole: 2
  secondaryRole: 3
  priceCR: 200
  chargesPerPurchase: 3
  cooldownSeconds: 1
  castRangeMetres: 45
  gameplaySummary: "Fumaça de cinzas divide uma linha longa. Um pulso térmico inicial informa a última posição dos inimigos muito próximos do impacto."
  activationRules: "Q/E/C arma o slot; o próximo disparo válido consome 1 carga e desarma o slot. Rajada, tiro duplo e pellets contam como um acionamento. Efeitos de impacto são criados uma vez no primeiro impacto válido dentro do alcance; efeitos no usuário ocorrem no disparo. Errar ou exceder alcance gasta a carga. Trocar arma, morrer ou recarregar cancela o preparo sem gasto. E perto do Dragão prioriza a interação de despertar e não arma cartucho."
  counterplay: "Sair da área antes do pulso ou mudar de posição após a marca. A marca não acompanha o alvo."
  visualDirection: "Coluna baixa de cinzas e aro âmbar na pedra; ping em forma de brasa, sem silhueta permanente."
  implementationNotes: "Dados e ficha de design. Não há SAASystem nem executor de efeitos no protótipo; este asset não altera projéteis, movimento, HUD ou vida automaticamente. Quantidades são propostas de playtest."
  designSheetPath: "Assets/Documentation/Arsenal/Spells/rifle_fire.md"
  effectColor: {r: 0.956863, g: 0.517647, b: 0.219608, a: 1}
  effects:
  - kind: 0
    target: 3
    anchor: 1
    durationSeconds: 6
    radiusMetres: 3
    amount: 0
    barrierHealth: 0
    barrierWidth: 0
    barrierHeight: 0
    rules: "Nuvem opaca; inimigos e aliados não enxergam através."
  - kind: 3
    target: 2
    anchor: 1
    durationSeconds: 0.6
    radiusMetres: 1.5
    amount: 0
    barrierHealth: 0
    barrierWidth: 0
    barrierHeight: 0
    rules: "Um único ping de última posição na criação, respeitando cobertura sólida."

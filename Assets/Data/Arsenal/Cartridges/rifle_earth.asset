    target: 3
    anchor: 1
    durationSeconds: 5
    radiusMetres: 0
    amount: 0
    barrierHealth: 180
    barrierWidth: 3
    barrierHeight: 2
    rules: "Parede com 0,4 m de profundidade; manter rota alternativa e acesso ao objetivo."
  - kind: 3

    target: 0
    anchor: 0
    durationSeconds: 1.5
    radiusMetres: 0
    amount: 0.2
    barrierHealth: 0
    barrierWidth: 0
    barrierHeight: 0
    rules: "Bônus de 20% na velocidade horizontal; não afeta gravidade nem altura do salto."
  - kind: 1

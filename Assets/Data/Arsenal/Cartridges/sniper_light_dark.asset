    radiusMetres: 3
    amount: 20
    barrierHealth: 0
    barrierWidth: 0
    barrierHeight: 0
    rules: "Cura única de 20 HP reais até 100; somente aliados vivos com linha de visão do atirador, incluindo o usuário."
  - kind: 3
